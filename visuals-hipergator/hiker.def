Bootstrap: docker
From: tensorflow/tensorflow:2.11.0

%files
    requirements.txt /tmp/requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    # System libs for the augmentation backend:
    #   libgl1-mesa-glx                  -> provides libGL.so.1 for opencv-python  [REQUIRED]
    # waterdrop (arcade/OpenGL) is skipped by default, so xvfb/libx11-6 are NOT
    # installed. To enable waterdrop on a GPU partition, add: xvfb libx11-6
    # (and arcade/pyvirtualdisplay in requirements.txt), then run under xvfb-run.
    apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-glx \
        && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip setuptools wheel packaging
    pip install --no-cache-dir -r /tmp/requirements.txt

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1

%labels
    Author visuals-dataset-generation
    Purpose Waymo HiKER augmentation pipeline on HiPerGator
